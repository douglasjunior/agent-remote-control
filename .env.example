# Discord Bot Credentials
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_GUILD_ID=

# Workspace Configuration
WORKSPACE_DIR=./workspaces

# Persisted data (conversation sessions and agent settings)
DATA_DIR=./data

# Idle time (ms) before a conversation's agent session is closed (default: 30 minutes)
SESSION_IDLE_TIMEOUT_MS=1800000

# Speech-to-text for audio attachments (whisper-cpp runs on CPU; none disables transcription)
STT_PROVIDER=whisper-cpp
# whisper.cpp model name (ggml-<name>.bin in DATA_DIR/models) or an explicit file path
STT_MODEL=small
# STT_MODEL_PATH=
# ISO 639-1 language code, or auto to detect it
STT_LANGUAGE=auto
# STT_THREADS=
# STT_TIMEOUT_MS=300000
# STT_WHISPER_BIN=whisper-cli
# STT_FFMPEG_BIN=ffmpeg

# Application Port
PORT=3000
