# Discord Bot Credentials
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_GUILD_ID=

# Workspace Configuration
WORKSPACE_DIR=./workspaces

# Persisted data (conversation sessions and agent settings)
DATA_DIR=./data

# Days the log files in DATA_DIR/logs are kept (default: 14)
LOG_RETENTION_DAYS=14

# Idle time (ms) before a conversation's agent session is closed (default: 30 minutes)
SESSION_IDLE_TIMEOUT_MS=1800000

# Time (ms) the user has to answer an agent's question before its recommended answer is assumed and the agent carries on;
# 0 disables the timeout (default: 5 minutes)
QUESTION_TIMEOUT_MS=300000

# Speech-to-text for audio attachments (whisper-cpp runs on CPU; none disables transcription)
STT_PROVIDER=whisper-cpp
# whisper.cpp model name (ggml-<name>.bin in DATA_DIR/models) or an explicit file path
STT_MODEL=small
# STT_MODEL_PATH=
# ISO 639-1 language code, or auto to detect it
STT_LANGUAGE=auto
# STT_THREADS=
# STT_TIMEOUT_MS=300000
# STT_WHISPER_BIN=whisper-cli
# STT_FFMPEG_BIN=ffmpeg

# Application Port
PORT=3000

# Log the agent CLIs in from the web interface and Discord (/agent-auth); set to false to leave it out
AGENT_AUTH_ENABLED=true

# Enable or disable shell command execution
SHELL_COMMAND_ENABLED=false

# Web interface (set to false to leave it out)
WEB_ENABLED=true
# Access token for the web interface; generated into DATA_DIR/web/access-token when empty
WEB_ACCESS_TOKEN=
# Browser origins allowed to open the WebSocket (comma-separated), for a web interface that reaches the server directly instead of through the Vite proxy or a reverse proxy
WEB_ALLOWED_ORIGINS=
