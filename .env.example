# Discord Bot Credentials
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_GUILD_ID=

# Workspace Configuration
WORKSPACE_DIR=./workspaces

# Persisted data (conversation sessions and agent settings)
DATA_DIR=./data

# Days the log files in DATA_DIR/logs are kept (default: 14)
LOG_RETENTION_DAYS=14

# Idle time (ms) before a conversation's agent session is closed (default: 30 minutes)
SESSION_IDLE_TIMEOUT_MS=1800000

# Time (ms) the user has to answer an agent's question before its recommended answer is assumed and the agent carries on;
# 0 disables the timeout (default: 5 minutes)
QUESTION_TIMEOUT_MS=300000

# How many times a prompt an agent failed on is sent again (0 disables the retry; default: 3) and the wait in ms before
# the first retry, doubling before each next one (default: 15000)
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY_MS=15000

# Delegations a task of the board goes through before the next one freezes it for the user to unfreeze; 0 disables it (default: 25)
ARTIFACT_MAX_DELEGATIONS=25

# Speech-to-text for audio attachments (whisper-cpp runs on CPU; none disables transcription)
STT_PROVIDER=whisper-cpp
# whisper.cpp model name (ggml-<name>.bin in DATA_DIR/models) or an explicit file path
STT_MODEL=small
# STT_MODEL_PATH=
# ISO 639-1 language code, or auto to detect it
STT_LANGUAGE=auto
# STT_THREADS=
# STT_TIMEOUT_MS=300000
# STT_WHISPER_BIN=whisper-cli
# STT_FFMPEG_BIN=ffmpeg

# Application Port
PORT=3000

# Log the agent CLIs in from the web interface and Discord (/agent-auth); set to false to leave it out
AGENT_AUTH_ENABLED=true

# Enable or disable shell command execution
SHELL_COMMAND_ENABLED=false

# Web interface (set to false to leave it out)
WEB_ENABLED=true
# Access token for the web interface; generated into DATA_DIR/web/access-token when empty
WEB_ACCESS_TOKEN=
# Browser origins allowed to open the WebSocket (comma-separated), for a web interface that reaches the server directly instead of through the Rsbuild dev proxy or a reverse proxy
WEB_ALLOWED_ORIGINS=
# Directory with the built web app (packages/web/dist) for the server to serve on PORT; leave empty to serve nothing
WEB_STATIC_DIR=
# Remote access from anywhere through the signaling server at REMOTE_URL; the server prints its link at startup.
# Whoever operates that server serves the page that holds the access token, so turn it on only for one you trust.
# Needs an access token of at least 32 characters (leave WEB_ACCESS_TOKEN empty to use the generated one).
REMOTE_ENABLED=false
# HTTPS URL of the signaling server that introduces browsers to this server and serves the web app the remote link
# opens; required with remote access, plain HTTP only for localhost. The author of this project runs
# https://arc-p2p-server.arc.douglasjunior.work
REMOTE_URL=
