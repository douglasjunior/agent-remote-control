    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite-tsconfig-paths": "^5.1.4",
