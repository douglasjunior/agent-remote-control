{
  "name": "agent-remote-control",
  "version": "0.0.1",
  "description": "Remote control and orchestration of AI coding agents over the Agent Client Protocol (ACP), through pluggable channel interfaces such as Discord.",
  "author": {
    "name": "Douglas Nassif Roma Junior",
    "email": "nassifrroma@gmail.com",
    "url": "https://github.com/douglasjunior"
  },
  "private": true,
  "license": "MIT",
  "tags": [
    "llm",
    "ai",
    "claude-code",
    "copilot",
    "codex",
    "cursor",
    "antigravity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/douglasjunior/agent-remote-control.git"
  },
  "bugs": {
    "url": "https://github.com/douglasjunior/agent-remote-control/issues"
  },
  "homepage": "https://github.com/douglasjunior/agent-remote-control",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @agent-remote-control/server dev",
    "dev:web": "pnpm --filter @agent-remote-control/web dev",
    "preview:web": "pnpm --filter @agent-remote-control/web preview",
    "start": "pnpm --filter @agent-remote-control/server start",
    "start:debug": "pnpm --filter @agent-remote-control/server start:debug",
    "start:prod": "pnpm --filter @agent-remote-control/server start:prod",
    "ts": "pnpm -r run ts",
    "format": "eslint packages/ --fix",
    "lint": "eslint packages/ --cache --cache-location .eslintcache/",
    "lint:fix": "eslint packages/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm --filter @agent-remote-control/server test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@nestjs/cli": "^12.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.21.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@12.16.1"
}
