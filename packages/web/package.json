{
  "name": "@agent-remote-control/web",
  "version": "0.0.1",
  "private": true,
  "description": "Web interface for Agent Remote Control.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "dev:p2p": "rsbuild dev --env-mode p2p",
    "build": "node ../../node_modules/typescript-native/bin/tsc --noEmit && rsbuild build",
    "build:p2p": "node ../../node_modules/typescript-native/bin/tsc --noEmit && rsbuild build --env-mode p2p",
    "ts": "node ../../node_modules/typescript-native/bin/tsc --noEmit",
    "preview": "rsbuild preview",
    "ui:relativize": "node scripts/relativize-imports.mjs",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@agent-remote-control/protocol": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "react-virtuoso": "^4.18.20",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/adapter-rsbuild": "^0.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react-grab": "^0.2.0"
  }
